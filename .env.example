# =============================================================================
# KONFIGURASI LINGKUNGAN (.env.example)
# Salin file ini menjadi `.env` di direktori root proyek `ppkmb-evaluation/`
# =============================================================================

APP_NAME="Sistem Evaluasi Kegiatan Mahasiswa terhadap PPKMB"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ppkmb-evaluation
APP_TIMEZONE=Asia/Jakarta

# Konfigurasi Database MySQL / MariaDB (Default Laragon Windows)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppkmb_sentiment_db
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi Eksekusi Python untuk Analisis Sentimen
# Di Laragon Windows dapat menggunakan `python` atau path absolut seperti:
# PYTHON_BIN="C:/laragon/bin/python/python-3.10/python.exe"
PYTHON_BIN=python

# Token Keamanan Internal untuk Endpoint API Analisis Sentimen
# Ganti dengan string acak minimal 32 karakter pada lingkungan produksi
SENTIMENT_API_SECRET=ppkmb_internal_api_key_change_this_in_production_2026

# Batas Rate Limiting Pengiriman Evaluasi & API (permintaan per menit per sesi/IP)
RATE_LIMIT_PER_MINUTE=20
MAX_COMMENT_LENGTH=2000
MAX_DATASET_UPLOAD_BYTES=2097152
